# Envio de e-mails (Resend) — valores reais SOMENTE nas variáveis de ambiente da Vercel. Nunca commitar a chave.
RESEND_API_KEY=
# Remetente verificado no Resend (o domínio precisa estar verificado). Ex.: Inscrições Farvalle <inscricoes@farvalle.edu.br>
RESEND_FROM=
# Opcional: destino das inscrições (padrão no código: secad@farvalle.edu.br)
INSCRICAO_TO=
